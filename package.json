{
  "name": "wechat-relationship-agent",
  "version": "0.1.0",
  "private": true,
  "description": "D1 desktop prototype for WeChat Relationship Agent",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
